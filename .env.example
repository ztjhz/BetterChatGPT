# All options are optional, remove those you do not need
VITE_CUSTOM_API_ENDPOINT=
VITE_DEFAULT_API_ENDPOINT=https://www.egida.cloud/api/chat/completions  # Default egida-app backend endpoint
VITE_OPENAI_API_KEY=
VITE_DEFAULT_SYSTEM_MESSAGE=     # Remove this line if you want to use the default system message of Better ChatGPT
VITE_GOOGLE_CLIENT_ID=           # for syncing data with google drive
VITE_CLERK_PUBLISHABLE_KEY=      # Clerk authentication key for egida-app integration
VITE_API_ENVIRONMENT=production  # API environment: production, development, staging